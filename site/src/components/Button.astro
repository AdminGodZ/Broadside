---
// The site's button: a link styled as one. `primary` is the filled ink version.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  primary?: boolean;
}
const { primary = false, class: className, ...rest } = Astro.props;
---

<a
  {...rest}
  class:list={[
    "with-icon gap-2.5 rounded border border-ink px-[22px] py-3.5 text-[1.05rem] leading-none font-medium no-underline transition-colors",
    primary
      ? "bg-ink text-paper hover:bg-[color-mix(in_oklab,var(--color-ink)_86%,var(--color-paper))]"
      : "text-ink hover:bg-water",
    className,
  ]}><slot /></a
>
