---
// The site's button: a link styled as one, or a real <button> when there is no href.
// `primary` is the filled ink version.
import type { HTMLAttributes } from "astro/types";

type Props = (HTMLAttributes<"a"> | HTMLAttributes<"button">) & { primary?: boolean };
const { primary = false, class: className, ...rest } = Astro.props;
const classes = [
  "with-icon cursor-pointer gap-2.5 rounded border border-ink px-[22px] py-3.5 text-[1.05rem] leading-none font-medium no-underline transition-colors disabled:cursor-default disabled:opacity-40",
  primary
    ? "bg-ink text-paper enabled:hover:bg-[color-mix(in_oklab,var(--color-ink)_86%,var(--color-paper))]"
    : "text-ink enabled:hover:bg-water",
  className,
];
---

{
  "href" in rest && rest.href ? (
    <a {...(rest as HTMLAttributes<"a">)} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type="button" {...(rest as HTMLAttributes<"button">)} class:list={classes}>
      <slot />
    </button>
  )
}
