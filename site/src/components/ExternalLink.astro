---
// A link that leaves the site: opens in a new tab, and ends with an icon that says so.
import ExternalLinkIcon from "@lucide/astro/icons/external-link";

interface Props {
  href: string;
  class?: string;
}
const { href, class: className } = Astro.props;
---

<a href={href} class:list={["with-icon gap-[.4em]", className]} target="_blank" rel="noopener">
  <slot />
  <ExternalLinkIcon class="icon -ml-[.05em] size-[.8em] opacity-75" aria-hidden="true" />
  <span class="sr-only">(opens in a new tab)</span>
</a>
