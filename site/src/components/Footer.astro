---
import Tag from "@lucide/astro/icons/tag";
import { RELEASES, REPO, VERSION } from "../lib/site";
import ExternalLink from "./ExternalLink.astro";
import GithubIcon from "./GithubIcon.astro";
---

<footer>
  <p>
    Broadside {VERSION}, made by <a href="https://admingod.ch">AdminGod</a>. Free under the{" "}
    <a href={`${REPO}/blob/main/LICENSE`}>MIT license</a>.
  </p>
  <nav aria-label="Footer">
    <ExternalLink href={REPO}><GithubIcon />Source</ExternalLink>
    <ExternalLink href={RELEASES}><Tag class="icon" />Releases</ExternalLink>
  </nav>
</footer>

<style>
  footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    margin-top: var(--section-gap); padding: 24px 0 40px; border-top: 1px solid var(--rule);
    color: var(--ink-soft); font-size: .95rem;
  }
  p { margin: 0; }
  nav { display: flex; gap: 24px; }
</style>
