---
import Download from "@lucide/astro/icons/download";
import Play from "@lucide/astro/icons/play";
import { VERSION } from "../lib/site";
import Replay from "./Replay.astro";
---

<section class="hero">
  <div>
    <h1>Broadside</h1>
    <p class="tagline">A Battleship engine that weighs every fleet that could be hiding before it takes a shot.</p>
    <div class="actions">
      <a class="button primary" href="/play"><Play class="icon" />Play in your browser</a>
      <a class="button" href="#download"><Download class="icon" />Download</a>
    </div>
    <p class="fine">Version {VERSION}. Free, and it runs offline.</p>
  </div>
  <Replay />
</section>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 470px); gap: 48px 72px;
    align-items: center; align-content: center; padding: clamp(32px, 7vw, 88px) 0 clamp(48px, 8vw, 96px);
    /* With the header, exactly the first screen: the numbers start below the fold. */
    min-height: calc(100svh - var(--header-h));
  }
  @media (max-width: 860px) { .hero { grid-template-columns: minmax(0, 1fr); } }
  h1 { font: 400 clamp(3.6rem, 11.5vw, 7.75rem)/.85 var(--stencil); letter-spacing: -.005em; margin-bottom: 28px; }
  .tagline { font-size: clamp(1.35rem, 2.6vw, 1.75rem); line-height: 1.35; max-width: 24ch; margin-bottom: 36px; }
</style>
