---
import Download from "@lucide/astro/icons/download";
import Play from "@lucide/astro/icons/play";
import { VERSION } from "../lib/site";
import Button from "./Button.astro";
import Replay from "./Replay.astro";
---

{/* With the header, exactly the first screen: what follows starts below the fold. */}
<section
  class="grid min-h-[calc(100svh_-_var(--spacing-header))] grid-cols-1 content-center items-center gap-x-18 gap-y-12 pt-[clamp(32px,7vw,88px)] pb-[clamp(48px,8vw,96px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,470px)]"
>
  <div>
    <h1 class="mb-7 font-stencil text-[clamp(3.6rem,11.5vw,7.75rem)] leading-[.85] font-normal tracking-[-.005em]">
      Broadside
    </h1>
    <p class="mb-9 max-w-[24ch] text-[clamp(1.35rem,2.6vw,1.75rem)] leading-[1.35]">
      A Battleship engine that weighs every fleet that could be hiding before it takes a shot.
    </p>
    <div class="mb-[18px] flex flex-wrap gap-3">
      <Button primary href="/play"><Play class="icon" />Play in your browser</Button>
      <Button href="#download"><Download class="icon" />Download</Button>
    </div>
    <p class="text-[.95rem] text-ink-soft">Version {VERSION}. Free, fully open source, and it runs offline.</p>
  </div>
  <Replay />
</section>
