---
import Brain from "@lucide/astro/icons/brain";
import GitBranch from "@lucide/astro/icons/git-branch";
import Sigma from "@lucide/astro/icons/sigma";
import { REPO } from "../lib/site";
import GithubIcon from "./GithubIcon.astro";

const ideas = [
  {
    icon: Sigma,
    title: "It counts every fleet",
    text: "Most bots guess where ships might be. Broadside counts every layout that fits the hits, misses and sinkings so far, exactly, and fires where a ship is most likely.",
  },
  {
    icon: GitBranch,
    title: "It plays the endgame out",
    text: "When few enough layouts remain, it plays each candidate shot to the end in every one of them and picks the shot that finishes fastest.",
  },
  {
    icon: Brain,
    title: "It learns how you play",
    text: "Over a session it learns where you like to hide ships and which waters you search last, so the games get harder the longer you play.",
  },
];
---

<section class="section" id="how">
  <h2>How it works</h2>
  <div class="ideas">
    {
      ideas.map(({ icon: Icon, title, text }) => (
        <div>
          <span class="tile">
            <Icon class="icon" />
          </span>
          <h3>{title}</h3>
          <p>{text}</p>
        </div>
      ))
    }
  </div>
  <p class="more">
    <a href={`${REPO}#how-it-works`} class="with-icon"><GithubIcon />Read the full method and every measurement on GitHub</a>
  </p>
</section>

<style>
  .ideas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 48px; margin-top: 12px; }
  @media (max-width: 860px) { .ideas { grid-template-columns: minmax(0, 1fr); } }
  .tile {
    display: grid; place-items: center; width: 46px; height: 46px; margin-bottom: 18px;
    border-radius: 10px; background: var(--water); border: 1px solid var(--rule);
  }
  .tile :global(.icon) { width: 22px; height: 22px; stroke-width: 1.6; }
  .ideas p { color: var(--ink-soft); margin: 0; max-width: 38ch; }
  .more { margin: 36px 0 0; }
</style>
