---
import HardDriveDownload from "@lucide/astro/icons/hard-drive-download";
import Play from "@lucide/astro/icons/play";
import { OFFLINE_GAME } from "../lib/site";
import Button from "./Button.astro";
---

<section class="pt-section text-center">
  <h2>Ready for a game?</h2>
  <p class="mx-auto mb-7 max-w-[44ch] text-ink-soft">Place your fleet, win the coin toss, and fire. It runs entirely in your browser; nothing is sent anywhere.</p>
  <div class="flex flex-wrap justify-center gap-3">
    <Button primary href="/play"><Play class="icon" />Start a game</Button>
    <Button href={OFFLINE_GAME} download="broadside.html"><HardDriveDownload class="icon" />Save it for offline play</Button>
  </div>
</section>
