---
import { Font } from "astro:assets";
import "../fonts/stencil.css";
import "../styles/global.css";
import logoDark from "../../../assets/logo-dark.svg";
import engineUrl from "../components/game/broadside.wasm?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  /** Whether the page sets italic text, so its font is fetched with the page. */
  italic?: boolean;
}
const { title, description, italic = false } = Astro.props;
// The site's addresses have no trailing slash (vercel.json); /play/ would redirect.
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), Astro.site);

// Following a link should feel instant. Chromium browsers prerender a page of the
// site once the pointer rests on a link to it (or the finger goes down), script
// and engine included; /play's page is fetched ahead as soon as there's a link to it.
// Downloads (the 2 MB offline game) are never fetched ahead.
const speculation = {
  prerender: [{ where: { and: [{ href_matches: "/*" }, { not: { selector_matches: "[download]" } }] }, eagerness: "moderate" }],
  prefetch: [{ where: { href_matches: "/play" }, eagerness: "eager" }],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#eff1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1b2c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={logoDark.src} type="image/svg+xml" />
    <Font cssVariable="--serif" preload={italic || [{ style: "normal" }]} />
    {/* The page shows once Newsreader is in, in one piece, so nothing moves as it arrives: laid out
        in a fallback first, text would wrap differently and push what's below. It's preloaded and
        small, so that's normally with the page itself. Should it take longer than 0.6 s (or never
        come: fonts blocked), the page shows in the metric-matched fallback and keeps it. A page
        prerendered ahead (see below) starts counting when it's shown. Only this script hides the
        page, and the timer is set first, so nothing can keep it hidden. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const serif = getComputedStyle(root).getPropertyValue("--serif");
        const font = `1em ${serif.split(",")[0]}`;
        let waiting = true;
        const show = () => {
          if (!waiting) return;
          waiting = false;
          root.classList.remove("fonts-wait");
          try {
            if (!document.fonts.check(font)) root.style.setProperty("--serif", serif.slice(serif.indexOf(",") + 1));
          } catch {}
        };
        root.classList.add("fonts-wait");
        const limit = () => setTimeout(show, 600);
        if (document.prerendering) document.addEventListener("prerenderingchange", limit, { once: true });
        else limit();
        document.fonts.load(font).then(show, show);
      })();
    </script>
    <slot name="head" />
    <script is:inline type="speculationrules" set:html={JSON.stringify(speculation)} />
    {/* Elsewhere (Safari, Firefox): on the first sign of heading for /play, fetch its page
        and engine into the cache. Assets under /_astro/ are cached for good (vercel.json). */}
    <script is:inline define:vars={{ engineUrl }}>
      if (!HTMLScriptElement.supports?.("speculationrules") && location.pathname !== "/play") {
        const warm = (e) => {
          if (!e.target.closest?.('a[href="/play"]')) return;
          for (const type of ["pointerover", "touchstart", "focusin"]) removeEventListener(type, warm, true);
          for (const url of ["/play", engineUrl]) fetch(url, { priority: "low" }).catch(() => {});
        };
        for (const type of ["pointerover", "touchstart", "focusin"]) addEventListener(type, warm, { capture: true, passive: true });
      }
    </script>
  </head>
  <body>
    <div class="mx-auto max-w-[1120px]">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
