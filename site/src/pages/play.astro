---
import Game from "../components/game/Game.astro";
import engineUrl from "../components/game/broadside.wasm?url";
import Base from "../layouts/Base.astro";
---

<Base
  title="Play Broadside"
  description="Play Battleship against the Broadside engine in your browser. It runs entirely on your device; nothing is sent anywhere."
>
  {/* The engine downloads alongside the page instead of after the script; game.ts compiles it as it arrives. */}
  <link slot="head" rel="preload" href={engineUrl} as="fetch" type="application/wasm" crossorigin />
  <Game />
</Base>
